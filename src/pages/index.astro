---
/*
 * index.astro — page d'accueil : hero plein écran + section « périple »
 * (tracé d'itinéraire SVG animé au scroll + timeline des 8 jours).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import TimelineCard from '../components/TimelineCard.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import carteOsm from '../assets/carte/poitiers-osm.jpg';

const jours = (await getCollection('jours')).sort(
  (a, b) => a.data.ordre - b.data.ordre,
);
const jour1 = jours[0];
---

<BaseLayout
  title="Souvenirs — Futuroscope & Poitiers"
  description="Huit jours de vacances de Lyon à Poitiers : road trip en Tesla, trois jours au Futuroscope, Aquascope, SPA au Clos de la Ribaudière et Vallée des Singes. Un carnet de voyage immersif."
  ogImage={jour1.data.cover}
>
  <main id="contenu">
    {/* ——— Hero d'accueil ——— */}
    <header class="hero-accueil">
      {/* Rideau de photos : colonnes verticales des covers qui défilent
          lentement (sens alterné), légèrement inclinées, estompées derrière
          le titre. Chaque colonne est dupliquée pour une boucle sans couture. */}
      <div class="rideau" aria-hidden="true">
        {
          [
            [0, 3, 6, 1],
            [2, 5, 0, 7],
            [4, 7, 2, 5],
            [6, 1, 4, 3],
          ].map((ordre, c) => (
            <div class={`rideau__colonne rideau__colonne--${c + 1}`}>
              <div class="rideau__defile">
                {[...ordre, ...ordre].map((idx) => (
                  <div class="rideau__carte">
                    <Image
                      class="rideau__img"
                      src={jours[idx].data.cover}
                      alt=""
                      widths={[360, 540]}
                      sizes="(min-width: 52rem) 16rem, 34vw"
                      loading="eager"
                    />
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>

      <div class="hero-accueil__contenu">
        <p class="hero-accueil__kicker">Carnet de voyage</p>
        <h1 class="hero-accueil__titre">
          <span>Futuroscope</span>
          <span class="hero-accueil__amp">&amp;</span>
          <span>Poitiers</span>
        </h1>
        <p class="hero-accueil__dates">25 juillet → 1<sup>er</sup> août 2026</p>
        <p class="hero-accueil__sous">8 jours de Lyon à Poitiers</p>
      </div>

      <a class="hero-accueil__scroll" href="#periple">
        <span>Le périple</span>
        <span class="hero-accueil__chevron" aria-hidden="true"></span>
      </a>
    </header>

    {/* ——— Périple : tracé + timeline ——— */}
    <section id="periple" class="periple section" aria-labelledby="periple-titre">
      <div class="periple__intro container">
        <h2 id="periple-titre" class="periple__titre">Le périple, jour après jour</h2>
        <p class="periple__accroche">
          De la route en Tesla jusqu'au retour au coucher du soleil, suivez le
          fil de nos huit journées le long du tracé Lyon&nbsp;→&nbsp;Poitiers.
        </p>
      </div>

      {/* Carte sticky à gauche + jours à droite. Chaque jour porte une
          view-timeline nommée (--jour-N) remontée par timeline-scope :
          quand un jour traverse le viewport, SON marqueur s'allume sur la
          carte et la carte du jour « sort » vers la droite. */}
      <div class="voyage container">
        <div class="voyage__carte" aria-hidden="true">
          <div class="carte">
            {/* Vraie carte OSM de la région (Poitiers, Futuroscope au nord,
                Vallée des Singes au sud), assombrie en CSS. */}
            <Image
              class="carte__osm"
              src={carteOsm}
              alt=""
              widths={[500, 1000]}
              sizes="(min-width: 52rem) 26rem, 60vw"
              loading="lazy"
            />

            <svg
              class="carte__svg"
              viewBox="0 0 100 161.6"
              preserveAspectRatio="none"
              fill="none"
            >
              {/* Le parcours est découpé en 8 segments, chacun dessiné par la
                  view-timeline de SON jour : le trait avance étape par étape
                  (Lyon → J1 → Poitiers → Futuroscope → … → Vallée des Singes
                  → retour vers Lyon), en phase avec la lecture. */}
              <path class="carte__trace carte__seg--1" d="M 100 47 C 91 47.5 80 48.5 73.6 51.1" pathLength="1" />
              <path class="carte__trace carte__seg--2" d="M 73.6 51.1 C 63 55.5 48.5 46.5 41.5 41.7" pathLength="1" />
              <path class="carte__trace carte__seg--3" d="M 41.5 41.7 C 39.8 34.5 40.6 26.8 42.7 22.3" pathLength="1" />
              <path class="carte__trace carte__seg--4" d="M 42.7 22.3 C 44.3 18.6 46.9 16.7 50.1 17.8" pathLength="1" />
              <path class="carte__trace carte__seg--5" d="M 50.1 17.8 C 53.2 19.3 55.3 23.6 53.6 27.3" pathLength="1" />
              <path class="carte__trace carte__seg--6" d="M 53.6 27.3 C 52.4 29.7 50.4 29.4 48.1 28.3" pathLength="1" />
              <path class="carte__trace carte__seg--7" d="M 48.1 28.3 C 39 44 37.6 95 38.3 147.1" pathLength="1" />
              <path class="carte__trace carte__seg--8 carte__trace--retour" d="M 38.3 147.1 C 53 152.5 68 143.5 81.4 134.8 C 88.5 130.2 95 129 100 129.5" pathLength="1" />
            </svg>

            <span class="carte__ville carte__ville--poitiers">Poitiers</span>
            <span class="carte__ville carte__ville--chasseneuil">Chasseneuil</span>
            <span class="carte__ville carte__ville--romagne">Romagne</span>
            <span class="carte__ville carte__ville--lyon">vers Lyon ↘</span>
            <span class="carte__attribution">© OpenStreetMap</span>

            {
              jours.map((jour, i) => (
                <span
                  class={`marqueur marqueur--${i + 1}${jour.data.ambiance ? ` accent-${jour.data.ambiance}` : ''}`}
                >
                  <span class="marqueur__pastille">{jour.data.emoji}</span>
                  <span class="marqueur__num">J{i + 1}</span>
                </span>
              ))
            }
          </div>
        </div>

        <ol class="voyage__jours">
          {
            jours.map((jour, i) => (
              <li
                class={`etape etape--${i + 1}${jour.data.ambiance ? ` accent-${jour.data.ambiance}` : ''}`}
              >
                <TimelineCard entry={jour} />
              </li>
            ))
          }
        </ol>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* ————————————————————— Hero ————————————————————— */
  .hero-accueil {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--esp-xl) var(--esp-sm);
    overflow: hidden;
    isolation: isolate;
  }

  /* ——— Rideau de photos vertical ——— */
  .rideau {
    position: absolute;
    inset: -12%;
    z-index: -2;
    display: flex;
    justify-content: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    /* Légère inclinaison d'ensemble, façon galerie moderne. */
    rotate: -6deg;
    /* Fondu haut/bas : les bandes s'estompent avant les bords du hero. */
    mask-image: linear-gradient(
      to bottom,
      transparent 4%,
      black 22%,
      black 72%,
      transparent 92%
    );
  }

  .rideau__colonne {
    flex: 0 0 clamp(9rem, 17vw, 15rem);
    overflow: hidden;
  }

  /* Les colonnes centrales sont poussées hors du centre optique du titre. */
  .rideau__colonne--2 { translate: 0 -6%; }
  .rideau__colonne--3 { translate: 0 5%; }

  .rideau__defile {
    display: flex;
    flex-direction: column;
    gap: clamp(0.75rem, 2vw, 1.5rem);
  }

  .rideau__carte {
    aspect-ratio: 3 / 2;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.1);
    flex: none;
  }

  .rideau__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.55;
    filter: saturate(1.05) brightness(0.75);
  }

  /* Défilement en boucle : le contenu est dupliqué, on translate de -50%.
   * Sens et vitesse alternés par colonne. */
  @media (prefers-reduced-motion: no-preference) {
    .rideau__defile {
      animation: rideau-monte var(--duree, 60s) linear infinite;
    }
    .rideau__colonne--1 .rideau__defile { --duree: 70s; }
    .rideau__colonne--2 .rideau__defile { animation-name: rideau-descend; --duree: 85s; }
    .rideau__colonne--3 .rideau__defile { --duree: 60s; }
    .rideau__colonne--4 .rideau__defile { animation-name: rideau-descend; --duree: 75s; }
  }

  @keyframes rideau-monte {
    from { translate: 0 0; }
    to   { translate: 0 -50%; }
  }

  @keyframes rideau-descend {
    from { translate: 0 -50%; }
    to   { translate: 0 0; }
  }

  /* Mobile : 2 colonnes seulement, calées sur les côtés. */
  @media (max-width: 51.99rem) {
    .rideau {
      gap: 0.75rem;
      justify-content: space-between;
      inset: -14% -6%;
    }
    .rideau__colonne--2,
    .rideau__colonne--3 {
      display: none;
    }
    .rideau__colonne {
      flex-basis: clamp(7rem, 34vw, 10rem);
    }
  }

  /* Voile : halo sombre derrière le titre (lisibilité au centre, rideau
   * visible sur les côtés) + fondu vers la section suivante. */
  .hero-accueil::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(
        68% 58% at 50% 42%,
        color-mix(in srgb, var(--bg) 92%, transparent) 0%,
        color-mix(in srgb, var(--bg) 62%, transparent) 55%,
        transparent 80%
      ),
      linear-gradient(to bottom, transparent 62%, var(--bg) 96%);
  }

  /* Halo accent discret derrière le titre. */
  .hero-accueil::after {
    content: '';
    position: absolute;
    z-index: -1;
    top: 38%;
    left: 50%;
    width: min(48rem, 90vw);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    background: radial-gradient(
      circle,
      var(--accent-voile) 0%,
      transparent 62%
    );
    pointer-events: none;
  }

  .hero-accueil__contenu {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--esp-sm);
    max-width: 60rem;
  }

  .hero-accueil__kicker {
    font-family: var(--font-titres), sans-serif;
    font-size: var(--taille-petit);
    font-weight: 600;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--accent-texte);
  }

  .hero-accueil__titre {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 0.98;
    font-size: var(--taille-titre-hero);
    text-shadow: 0 2px 40px color-mix(in srgb, var(--bg) 80%, transparent);
  }

  .hero-accueil__amp {
    font-weight: 400;
    color: var(--accent);
    font-size: 0.7em;
    margin-block: -0.05em;
  }

  .hero-accueil__dates {
    margin-top: var(--esp-xs);
    font-family: var(--font-titres), sans-serif;
    font-size: var(--taille-h3);
    font-weight: 600;
    color: var(--texte);
  }

  .hero-accueil__dates sup {
    font-size: 0.6em;
  }

  .hero-accueil__sous {
    font-size: var(--taille-corps);
    color: var(--texte-doux);
    letter-spacing: 0.01em;
  }

  /* Indicateur de scroll. */
  .hero-accueil__scroll {
    position: absolute;
    bottom: var(--esp-lg);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--esp-2xs);
    font-family: var(--font-titres), sans-serif;
    font-size: var(--taille-petit);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--texte-doux);
    transition: color var(--transition);
  }

  .hero-accueil__scroll:hover {
    color: var(--accent);
  }

  .hero-accueil__chevron {
    width: 0.85rem;
    height: 0.85rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-accueil__chevron {
      animation: hero-rebond 1.8s ease-in-out infinite;
    }
  }

  @keyframes hero-rebond {
    0%,
    100% {
      transform: rotate(45deg) translate(0, 0);
      opacity: 0.7;
    }
    50% {
      transform: rotate(45deg) translate(3px, 3px);
      opacity: 1;
    }
  }

  /* ————————————————————— Périple ————————————————————— */
  .periple {
    position: relative;
    /* `clip` et pas `hidden` : hidden ferait de la section le conteneur de
     * défilement du sticky de la carte (qui ne collerait plus jamais). */
    overflow: clip;
    /* Contexte d'empilement : le voile ::before (z-index -1) reste au-dessus
     * du fond opaque du body. */
    isolation: isolate;
  }

  /* Voyage chromatique : en descendant la timeline, le fond se teinte
   * successivement de l'accent de chaque jour (rouge route → ambre sunset).
   * Piloté par la progression de la section dans le viewport, 0 Ko de JS. */
  /* Typage de --etape : sans @property, une custom property animée saute
   * d'un keyframe à l'autre au lieu de s'interpoler comme une couleur. */
  @property --etape {
    syntax: '<color>';
    inherits: false;
    initial-value: #e82127;
  }

  @supports (animation-timeline: view()) {
    .periple::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      /* La couleur du jour traversé vit dans --etape ; le dégradé la module
       * (plus dense sur les bords, respiration au centre) pour un rendu
       * moins « aplat » qu'un simple fond uni. */
      --etape: #e82127;
      background:
        radial-gradient(
          120% 90% at 50% 50%,
          color-mix(in srgb, var(--etape) 10%, transparent) 0%,
          color-mix(in srgb, var(--etape) 26%, transparent) 100%
        );
      /* `screen` éclaircit le fond avec la teinte au lieu de la noyer dans le
       * bleu nuit : chaque étape garde sa vraie couleur (rouge, cyan, vert…). */
      mix-blend-mode: screen;
      animation: periple-voyage linear both;
      animation-timeline: view();
      animation-range: cover 0% cover 100%;
    }
  }

  @keyframes periple-voyage {
    0%   { --etape: #e82127; }
    14%  { --etape: #fb923c; }
    28%  { --etape: #22d3ee; }
    42%  { --etape: #8b5cf6; }
    56%  { --etape: #ec4899; }
    70%  { --etape: #34d399; }
    84%  { --etape: #22c55e; }
    100% { --etape: #f59e0b; }
  }

  @media (prefers-reduced-motion: reduce) {
    .periple::before {
      animation: none !important;
    }
  }

  .periple__intro {
    text-align: center;
    max-width: var(--largeur-prose);
    margin-bottom: var(--esp-xl);
  }

  .periple__titre {
    font-size: var(--taille-h2);
  }

  .periple__accroche {
    margin-top: var(--esp-sm);
    color: var(--texte-doux);
    text-wrap: balance;
  }

  /* ————————— Voyage : carte sticky + jours ————————— */
  .voyage {
    display: grid;
    grid-template-columns: minmax(17rem, 26rem) 1fr;
    gap: clamp(1.5rem, 4vw, 4rem);
    /* PAS d'align-items: start — la colonne de la carte doit s'étirer sur
     * toute la hauteur de la rangée pour donner sa course au sticky. */
    /* Remonte les view-timelines des jours (colonne droite) au niveau du
     * conteneur pour que les marqueurs de la carte (colonne gauche) puissent
     * s'y abonner. */
    timeline-scope:
      --jour-1, --jour-2, --jour-3, --jour-4,
      --jour-5, --jour-6, --jour-7, --jour-8;
  }

  .voyage__carte {
    position: relative;
  }

  /* Dimensionné au ratio exact de l'image OSM (1000×1616) : les positions en
   * % des marqueurs correspondent ainsi précisément aux lieux réels. */
  .carte {
    position: sticky;
    top: 3vh;
    width: min(100%, calc(94vh / 1.616));
    aspect-ratio: 1000 / 1616;
    margin-inline: auto;
    border-radius: var(--rayon-carte, 20px);
    border: 1px solid rgb(255 255 255 / 0.08);
    background: color-mix(in srgb, var(--bg) 88%, #1b2344);
    overflow: hidden;
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.45);
  }

  /* Fond OSM passé en mode nuit : inversion + rotation de teinte. */
  .carte__osm {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: fill;
    filter: grayscale(0.15) invert(0.92) hue-rotate(185deg) saturate(0.85)
      brightness(0.92) contrast(0.95);
  }

  /* Vignette : fond lisible sous les marqueurs, bords fondus dans la page. */
  .carte::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(110% 110% at 50% 50%, transparent 55%, rgb(5 8 20 / 0.55) 100%),
      linear-gradient(to bottom, rgb(5 8 20 / 0.3), transparent 18%);
  }

  .carte__attribution {
    position: absolute;
    right: 0.6rem;
    bottom: 0.4rem;
    z-index: 2;
    font-size: 0.58rem;
    letter-spacing: 0.04em;
    color: rgb(232 234 242 / 0.55);
  }

  .carte__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* PAS de vector-effect: non-scaling-stroke ici : combiné à pathLength="1",
   * Chrome calcule alors le dash en pixels écran et le dessin au scroll
   * devient des pointillés erratiques. Le panneau ayant le ratio exact du
   * viewBox, l'épaisseur reste uniforme (unités viewBox ≈ ×4 à l'écran). */
  .carte__trace {
    stroke: color-mix(in srgb, var(--accent) 75%, #ffffff);
    stroke-width: 0.55;
    stroke-linecap: round;
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--accent) 55%, transparent));
  }

  /* Retour : ambre, un peu plus fin (le motif pointillé est incompatible
   * avec le dessin par stroke-dashoffset). */
  .carte__trace--retour {
    stroke: color-mix(in srgb, #f59e0b 80%, #ffffff);
    stroke-width: 0.45;
    opacity: 0.9;
    filter: drop-shadow(0 0 6px rgb(245 158 11 / 0.4));
  }

  .carte__ville {
    position: absolute;
    translate: -50% -50%;
    font-family: var(--font-titres), sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--texte-doux);
  }

  .carte__ville--poitiers { left: 27%; top: 30.5%; }
  .carte__ville--chasseneuil { left: 45.7%; top: 6.8%; }
  .carte__ville--romagne { left: 50%; top: 94.5%; }
  .carte__ville--lyon { left: 82%; top: 90%; font-size: 0.62rem; }

  /* ——— Marqueurs d'étape sur la carte ——— */
  .marqueur {
    position: absolute;
    translate: -50% -50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
  }

  .marqueur__pastille {
    display: grid;
    place-items: center;
    width: 2.15rem;
    height: 2.15rem;
    font-size: 1rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--bg) 72%, var(--accent));
    border: 1.5px solid var(--accent);
    box-shadow: 0 0 14px color-mix(in srgb, var(--accent) 60%, transparent);
  }

  .marqueur__num {
    font-family: var(--font-titres), sans-serif;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--texte-doux);
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    padding: 0.05rem 0.3rem;
    border-radius: 99px;
  }

  /* Positions géographiques réelles (projection Mercator → % de la bbox). */
  .marqueur--1 { left: 73.6%; top: 31.6%; } /* arrivée par l'A10 */
  .marqueur--2 { left: 41.5%; top: 25.8%; } /* Poitiers / Sensas */
  .marqueur--3 { left: 42.7%; top: 13.8%; } /* Futuroscope */
  .marqueur--4 { left: 50.1%; top: 11%;   } /* Futuroscope / Aquascope */
  .marqueur--5 { left: 53.6%; top: 16.9%; } /* Futuroscope dernier jour */
  .marqueur--6 { left: 48.1%; top: 17.5%; } /* Clos de la Ribaudière */
  .marqueur--7 { left: 38.3%; top: 91%;   } /* Vallée des Singes, Romagne */
  .marqueur--8 { left: 81.4%; top: 83.4%; } /* départ vers Lyon */

  /* ——— Colonne des jours ——— */
  .voyage__jours {
    display: flex;
    flex-direction: column;
    gap: clamp(8rem, 26vh, 16rem);
    padding-block: 4vh 10vh;
    max-width: 34rem;
    width: 100%;
    margin-inline: auto;
  }

  /* Chaque étape publie sa progression de visibilité sous un nom connu. */
  .etape--1 { view-timeline: --jour-1 block; }
  .etape--2 { view-timeline: --jour-2 block; }
  .etape--3 { view-timeline: --jour-3 block; }
  .etape--4 { view-timeline: --jour-4 block; }
  .etape--5 { view-timeline: --jour-5 block; }
  .etape--6 { view-timeline: --jour-6 block; }
  .etape--7 { view-timeline: --jour-7 block; }
  .etape--8 { view-timeline: --jour-8 block; }

  /* ——— Animations pilotées par le scroll (navigateurs modernes) ——— */
  @supports (timeline-scope: --a) and (animation-timeline: view()) {
    /* Chaque segment se dessine pendant que SON jour entre dans le viewport :
     * le trait rejoint l'étape juste avant que sa page n'arrive. */
    .carte__trace {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: carte-tracer linear both;
      animation-range: entry 0% cover 45%;
    }
    .carte__seg--1 { animation-timeline: --jour-1; }
    .carte__seg--2 { animation-timeline: --jour-2; }
    .carte__seg--3 { animation-timeline: --jour-3; }
    .carte__seg--4 { animation-timeline: --jour-4; }
    .carte__seg--5 { animation-timeline: --jour-5; }

---
/*
 * index.astro — page d'accueil : hero plein écran + section « périple »
 * (tracé d'itinéraire SVG animé au scroll + timeline des 8 jours).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Itineraire from '../components/Itineraire.astro';
import Timeline from '../components/Timeline.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const jours = (await getCollection('jours')).sort(
  (a, b) => a.data.ordre - b.data.ordre,
);
const jour1 = jours[0];
---

<BaseLayout
  title="Souvenirs — Futuroscope & Poitiers"
  description="Huit jours de vacances de Lyon à Poitiers : road trip en Tesla, trois jours au Futuroscope, Aquascope, SPA au Clos de la Ribaudière et Vallée des Singes. Un carnet de voyage immersif."
  ogImage={jour1.data.cover}
>
  <main id="contenu">
    {/* ——— Hero d'accueil ——— */}
    <header class="hero-accueil">
      {/* Rideau de photos : colonnes verticales des covers qui défilent
          lentement (sens alterné), légèrement inclinées, estompées derrière
          le titre. Chaque colonne est dupliquée pour une boucle sans couture. */}
      <div class="rideau" aria-hidden="true">
        {
          [
            [0, 3, 6, 1],
            [2, 5, 0, 7],
            [4, 7, 2, 5],
            [6, 1, 4, 3],
          ].map((ordre, c) => (
            <div class={`rideau__colonne rideau__colonne--${c + 1}`}>
              <div class="rideau__defile">
                {[...ordre, ...ordre].map((idx) => (
                  <div class="rideau__carte">
                    <Image
                      class="rideau__img"
                      src={jours[idx].data.cover}
                      alt=""
                      widths={[360, 540]}
                      sizes="(min-width: 52rem) 16rem, 34vw"
                      loading="eager"
                    />
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>

      <div class="hero-accueil__contenu">
        <p class="hero-accueil__kicker">Carnet de voyage</p>
        <h1 class="hero-accueil__titre">
          <span>Futuroscope</span>
          <span class="hero-accueil__amp">&amp;</span>
          <span>Poitiers</span>
        </h1>
        <p class="hero-accueil__dates">25 juillet → 1<sup>er</sup> août 2026</p>
        <p class="hero-accueil__sous">8 jours de Lyon à Poitiers</p>
      </div>

      <a class="hero-accueil__scroll" href="#periple">
        <span>Le périple</span>
        <span class="hero-accueil__chevron" aria-hidden="true"></span>
      </a>
    </header>

    {/* ——— Périple : tracé + timeline ——— */}
    <section id="periple" class="periple section" aria-labelledby="periple-titre">
      <div class="periple__intro container">
        <h2 id="periple-titre" class="periple__titre">Le périple, jour après jour</h2>
        <p class="periple__accroche">
          De la route en Tesla jusqu'au retour au coucher du soleil, suivez le
          fil de nos huit journées le long du tracé Lyon&nbsp;→&nbsp;Poitiers.
        </p>
      </div>

      <div class="periple__piste">
        <Itineraire />
        <Timeline />
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* ————————————————————— Hero ————————————————————— */
  .hero-accueil {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--esp-xl) var(--esp-sm);
    overflow: hidden;
    isolation: isolate;
  }

  /* ——— Rideau de photos vertical ——— */
  .rideau {
    position: absolute;
    inset: -12%;
    z-index: -2;
    display: flex;
    justify-content: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    /* Légère inclinaison d'ensemble, façon galerie moderne. */
    rotate: -6deg;
    /* Fondu haut/bas : les bandes s'estompent avant les bords du hero. */
    mask-image: linear-gradient(
      to bottom,
      transparent 4%,
      black 22%,
      black 72%,
      transparent 92%
    );
  }

  .rideau__colonne {
    flex: 0 0 clamp(9rem, 17vw, 15rem);
    overflow: hidden;
  }

  /* Les colonnes centrales sont poussées hors du centre optique du titre. */
  .rideau__colonne--2 { translate: 0 -6%; }
  .rideau__colonne--3 { translate: 0 5%; }

  .rideau__defile {
    display: flex;
    flex-direction: column;
    gap: clamp(0.75rem, 2vw, 1.5rem);
  }

  .rideau__carte {
    aspect-ratio: 3 / 2;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.1);
    flex: none;
  }

  .rideau__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.55;
    filter: saturate(1.05) brightness(0.75);
  }

  /* Défilement en boucle : le contenu est dupliqué, on translate de -50%.
   * Sens et vitesse alternés par colonne. */
  @media (prefers-reduced-motion: no-preference) {
    .rideau__defile {
      animation: rideau-monte var(--duree, 60s) linear infinite;
    }
    .rideau__colonne--1 .rideau__defile { --duree: 70s; }
    .rideau__colonne--2 .rideau__defile { animation-name: rideau-descend; --duree: 85s; }
    .rideau__colonne--3 .rideau__defile { --duree: 60s; }
    .rideau__colonne--4 .rideau__defile { animation-name: rideau-descend; --duree: 75s; }
  }

  @keyframes rideau-monte {
    from { translate: 0 0; }
    to   { translate: 0 -50%; }
  }

  @keyframes rideau-descend {
    from { translate: 0 -50%; }
    to   { translate: 0 0; }
  }

  /* Mobile : 2 colonnes seulement, calées sur les côtés. */
  @media (max-width: 51.99rem) {
    .rideau {
      gap: 0.75rem;
      justify-content: space-between;
      inset: -14% -6%;
    }
    .rideau__colonne--2,
    .rideau__colonne--3 {
      display: none;
    }
    .rideau__colonne {
      flex-basis: clamp(7rem, 34vw, 10rem);
    }
  }

  /* Voile : halo sombre derrière le titre (lisibilité au centre, rideau
   * visible sur les côtés) + fondu vers la section suivante. */
  .hero-accueil::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(
        68% 58% at 50% 42%,
        color-mix(in srgb, var(--bg) 92%, transparent) 0%,
        color-mix(in srgb, var(--bg) 62%, transparent) 55%,
        transparent 80%
      ),
      linear-gradient(to bottom, transparent 62%, var(--bg) 96%);
  }

  /* Halo accent discret derrière le titre. */
  .hero-accueil::after {
    content: '';
    position: absolute;
    z-index: -1;
    top: 38%;
    left: 50%;
    width: min(48rem, 90vw);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    background: radial-gradient(
      circle,
      var(--accent-voile) 0%,
      transparent 62%
    );
    pointer-events: none;
  }

  .hero-accueil__contenu {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--esp-sm);
    max-width: 60rem;
  }

  .hero-accueil__kicker {
    font-family: var(--font-titres), sans-serif;
    font-size: var(--taille-petit);
    font-weight: 600;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--accent-texte);
  }

  .hero-accueil__titre {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 0.98;
    font-size: var(--taille-titre-hero);
    text-shadow: 0 2px 40px color-mix(in srgb, var(--bg) 80%, transparent);
  }

  .hero-accueil__amp {
    font-weight: 400;
    color: var(--accent);
    font-size: 0.7em;
    margin-block: -0.05em;
  }

  .hero-accueil__dates {
    margin-top: var(--esp-xs);
    font-family: var(--font-titres), sans-serif;
    font-size: var(--taille-h3);
    font-weight: 600;
    color: var(--texte);
  }

  .hero-accueil__dates sup {
    font-size: 0.6em;
  }

  .hero-accueil__sous {
    font-size: var(--taille-corps);
    color: var(--texte-doux);
    letter-spacing: 0.01em;
  }

  /* Indicateur de scroll. */
  .hero-accueil__scroll {
    position: absolute;
    bottom: var(--esp-lg);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--esp-2xs);
    font-family: var(--font-titres), sans-serif;
    font-size: var(--taille-petit);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--texte-doux);
    transition: color var(--transition);
  }

  .hero-accueil__scroll:hover {
    color: var(--accent);
  }

  .hero-accueil__chevron {
    width: 0.85rem;
    height: 0.85rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-accueil__chevron {
      animation: hero-rebond 1.8s ease-in-out infinite;
    }
  }

  @keyframes hero-rebond {
    0%,
    100% {
      transform: rotate(45deg) translate(0, 0);
      opacity: 0.7;
    }
    50% {
      transform: rotate(45deg) translate(3px, 3px);
      opacity: 1;
    }
  }

  /* ————————————————————— Périple ————————————————————— */
  .periple {
    position: relative;
    overflow: hidden;
    /* Contexte d'empilement : le voile ::before (z-index -1) reste au-dessus
     * du fond opaque du body. */
    isolation: isolate;
  }

  /* Voyage chromatique : en descendant la timeline, le fond se teinte
   * successivement de l'accent de chaque jour (rouge route → ambre sunset).
   * Piloté par la progression de la section dans le viewport, 0 Ko de JS. */
  /* Typage de --etape : sans @property, une custom property animée saute
   * d'un keyframe à l'autre au lieu de s'interpoler comme une couleur. */
  @property --etape {
    syntax: '<color>';
    inherits: false;
    initial-value: #e82127;
  }

  @supports (animation-timeline: view()) {
    .periple::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      /* La couleur du jour traversé vit dans --etape ; le dégradé la module
       * (plus dense sur les bords, respiration au centre) pour un rendu
       * moins « aplat » qu'un simple fond uni. */
      --etape: #e82127;
      background:
        radial-gradient(
          120% 90% at 50% 50%,
          color-mix(in srgb, var(--etape) 10%, transparent) 0%,
          color-mix(in srgb, var(--etape) 26%, transparent) 100%
        );
      /* `screen` éclaircit le fond avec la teinte au lieu de la noyer dans le
       * bleu nuit : chaque étape garde sa vraie couleur (rouge, cyan, vert…). */
      mix-blend-mode: screen;
      animation: periple-voyage linear both;
      animation-timeline: view();
      animation-range: cover 0% cover 100%;
    }
  }

  @keyframes periple-voyage {
    0%   { --etape: #e82127; }
    14%  { --etape: #fb923c; }
    28%  { --etape: #22d3ee; }
    42%  { --etape: #8b5cf6; }
    56%  { --etape: #ec4899; }
    70%  { --etape: #34d399; }
    84%  { --etape: #22c55e; }
    100% { --etape: #f59e0b; }
  }

  @media (prefers-reduced-motion: reduce) {
    .periple::before {
      animation: none !important;
    }
  }

  .periple__intro {
    text-align: center;
    max-width: var(--largeur-prose);
    margin-bottom: var(--esp-xl);
  }

  .periple__titre {
    font-size: var(--taille-h2);
  }

  .periple__accroche {
    margin-top: var(--esp-sm);
    color: var(--texte-doux);
    text-wrap: balance;
  }

  /* Piste : contexte de positionnement pour le tracé absolu + la timeline. */
  .periple__piste {
    position: relative;
  }
</style>

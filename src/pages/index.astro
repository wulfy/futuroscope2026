---
/*
 * index.astro — page d'accueil : hero plein écran + section « périple »
 * (tracé d'itinéraire SVG animé au scroll + timeline des 8 jours).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import TimelineCard from '../components/TimelineCard.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import carteOsm from '../assets/carte/poitiers-osm.jpg';

const jours = (await getCollection('jours')).sort(
  (a, b) => a.data.ordre - b.data.ordre,
);
const jour1 = jours[0];

/*
 * Images du rideau du hero : les 8 covers des jours EN PRIORITÉ, complétées
 * par d'autres photos des pages (galeries) choisies pseudo-aléatoirement —
 * aucune image n'apparaît deux fois dans le rideau.
 */
/* `ImageMetadata` est un type global ambiant fourni par astro/client. */
const tousMedias = import.meta.glob<ImageMetadata>(
  '/src/assets/medias/**/*.{jpg,jpeg,png,webp,JPG,JPEG}',
  { eager: true, import: 'default' },
);

const covers = jours.map((j) => j.data.cover);
const coverSrcs = new Set(covers.map((c) => c.src));

// Mélange pseudo-aléatoire mais DÉTERMINISTE (hash du chemin) : le rendu
// varie quand les médias changent, pas à chaque build.
const hashChemin = (s: string) => {
  let h = 0;
  for (const c of s) h = (h * 31 + c.charCodeAt(0)) | 0;
  return h;
};

const autresPhotos = Object.entries(tousMedias)
  .filter(([chemin, img]) => !/\/ambiance-/.test(chemin) && !coverSrcs.has(img.src))
  .sort(([a], [b]) => hashChemin(a) - hashChemin(b))
  .map(([, img]) => img);

// 4 colonnes × 4 visuels = 16 images uniques : covers d'abord, le reste en
// complément. Répartition en tourniquet pour disperser les covers partout.
const NB_COLONNES = 4;
const PAR_COLONNE = 4;
const rideauImages = [...covers, ...autresPhotos].slice(0, NB_COLONNES * PAR_COLONNE);
const rideauColonnes: ImageMetadata[][] = Array.from({ length: NB_COLONNES }, () => []);
rideauImages.forEach((img, i) => rideauColonnes[i % NB_COLONNES].push(img));
---

<BaseLayout
  title="Souvenirs — Futuroscope & Poitiers"
  description="Huit jours de vacances de Lyon à Poitiers : road trip en Tesla, trois jours au Futuroscope, Aquascope, SPA au Clos de la Ribaudière et Vallée des Singes. Un carnet de voyage immersif."
  ogImage={jour1.data.cover}
>
  <main id="contenu">
    {/* ——— Hero d'accueil ——— */}
    <header class="hero-accueil">
      {/* Rideau de photos : colonnes verticales qui défilent lentement (sens
          alterné), légèrement inclinées, estompées derrière le titre. 16
          images UNIQUES : les covers des 8 jours en priorité + photos des
          galeries en complément. Seule la duplication mécanique de chaque
          colonne (nécessaire à la boucle sans couture) répète un visuel. */}
      <div class="rideau" aria-hidden="true">
        {
          rideauColonnes.map((colonne, c) => (
            <div class={`rideau__colonne rideau__colonne--${c + 1}`}>
              <div class="rideau__defile">
                {[...colonne, ...colonne].map((img) => (
                  <div class="rideau__carte">
                    <Image
                      class="rideau__img"
                      src={img}
                      alt=""
                      widths={[360, 540]}
                      sizes="(min-width: 52rem) 16rem, 34vw"
                      loading="eager"
                    />
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>

      <div class="hero-accueil__contenu">
        <p class="hero-accueil__kicker">Carnet de voyage</p>
        <h1 class="hero-accueil__titre">
          <span>Futuroscope</span>
          <span class="hero-accueil__amp">&amp;</span>
          <span>Poitiers</span>
        </h1>
        <p class="hero-accueil__dates">25 juillet → 1<sup>er</sup> août 2026</p>
        <p class="hero-accueil__sous">8 jours de Lyon à Poitiers</p>
      </div>

      <a class="hero-accueil__scroll" href="#periple">
        <span>Le périple</span>
        <span class="hero-accueil__chevron" aria-hidden="true"></span>
      </a>
    </header>

    {/* ——— Périple : tracé + timeline ——— */}
    <section id="periple" class="periple section" aria-labelledby="periple-titre">
      <div class="periple__intro container">
        <h2 id="periple-titre" class="periple__titre">Le périple, jour après jour</h2>
        <p class="periple__accroche">
          De la route en Tesla jusqu'au retour au coucher du soleil, suivez le
          fil de nos huit journées le long du tracé Lyon&nbsp;→&nbsp;Poitiers.
        </p>
      </div>

      {/* Carte sticky à gauche + jours à droite. Chaque jour porte une
          view-timeline nommée (--jour-N) remontée par timeline-scope :
          quand un jour traverse le viewport, SON marqueur s'allume sur la
          carte et la carte du jour « sort » vers la droite. */}
      <div class="voyage container">
        {/* Fonds immersifs : la cover du jour lu apparaît en plein écran,
            très atténuée, avec fondu croisé entre jours voisins — pilotée
            par la view-timeline du jour (même mécanique que les marqueurs). */}
        <div class="fonds" aria-hidden="true">
          {
            jours.map((jour, i) => (
              <div class={`fonds__calque fonds__calque--${i + 1}`}>
                <Image
                  class="fonds__img"
                  src={jour.data.cover}
                  alt=""
                  widths={[1280, 1920]}
                  sizes="100vw"
                  loading="lazy"
                />
              </div>
            ))
          }
        </div>

        <div class="voyage__carte" aria-hidden="true">
          <div class="carte">
            {/* Vraie carte OSM de la région (Poitiers, Futuroscope au nord,
                Vallée des Singes au sud), assombrie en CSS. */}
            <Image
              class="carte__osm"
              src={carteOsm}
              alt=""
              widths={[500, 1000]}
              sizes="(min-width: 52rem) 26rem, 60vw"
              loading="lazy"
            />

            <svg
              class="carte__svg"
              viewBox="0 0 100 47.2"
              preserveAspectRatio="none"
              fill="none"
            >
              {/* Le parcours est découpé en 8 segments, chacun dessiné par la
                  view-timeline de SON jour : Lyon → halte de recharge (J1) →
                  Poitiers → Futuroscope → … → Vallée des Singes → retour à
                  Lyon, en phase avec la lecture. */}
              <path class="carte__trace carte__seg--1" d="M 95.7 35.5 C 88 32 70 30 61.4 33" pathLength="1" />
              <path class="carte__trace carte__seg--2" d="M 61.4 33 C 48 30 22 22 6.7 12.1" pathLength="1" />
              <path class="carte__trace carte__seg--3" d="M 6.7 12.1 C 6.4 11 6.6 10.2 7.3 9.6" pathLength="1" />
              <path class="carte__trace carte__seg--4" d="M 7.3 9.6 C 9 7.2 11 6 13 5.7" pathLength="1" />
              <path class="carte__trace carte__seg--5" d="M 13 5.7 C 15.5 6.4 17 7.6 17 9.4" pathLength="1" />
              <path class="carte__trace carte__seg--6" d="M 17 9.4 C 16.7 11.3 15.7 12.6 14 13.2" pathLength="1" />
              <path class="carte__trace carte__seg--7" d="M 14 13.2 C 11 17 7.5 22 6.3 26.8" pathLength="1" />
              <path class="carte__trace carte__seg--8 carte__trace--retour" d="M 6.3 26.8 C 25 38 55 44 77.2 39.6 C 85 38 92 36.5 95.7 35.8" pathLength="1" />
            </svg>

            <span class="carte__ville carte__ville--lyon">Lyon</span>
            <span class="carte__ville carte__ville--poitiers">Poitiers</span>
            <span class="carte__ville carte__ville--romagne">Romagne</span>
            <span class="carte__ville carte__ville--clermont">Clermont-Fd</span>
            <span class="carte__attribution">© OpenStreetMap</span>

            {
              jours.map((jour, i) => (
                <span
                  class={`marqueur marqueur--${i + 1}${jour.data.ambiance ? ` accent-${jour.data.ambiance}` : ''}`}
                >
                  <span class="marqueur__pastille">{jour.data.emoji}</span>
                  <span class="marqueur__num">J{i + 1}</span>
                </span>
              ))
            }
          </div>
        </div>

        <ol class="voyage__jours">
          {
            jours.map((jour, i) => (
              <li
                class={`etape etape--${i + 1}${jour.data.ambiance ? ` accent-${jour.data.ambiance}` : ''}`}
              >
                <TimelineCard entry={jour} />
              </li>
            ))
          }
        </ol>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* ————————————————————— Hero ————————————————————— */
  .hero-accueil {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--esp-xl) var(--esp-sm);
    overflow: hidden;
    isolation: isolate;
  }

  /* ——— Rideau de photos vertical ——— */
  .rideau {
    position: absolute;
    inset: -12%;
    z-index: -2;
    display: flex;
    justify-content: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    /* Légère inclinaison d'ensemble, façon galerie moderne. */
    rotate: -6deg;
    /* Fondu haut/bas : les bandes s'estompent avant les bords du hero. */
    mask-image: linear-gradient(
      to bottom,
      transparent 4%,
      black 22%,
      black 72%,
      transparent 92%
    );
  }

  .rideau__colonne {
    flex: 0 0 clamp(9rem, 17vw, 15rem);
    overflow: hidden;
  }

  /* Les colonnes centrales sont poussées hors du centre optique du titre. */
  .rideau__colonne--2 { translate: 0 -6%; }
  .rideau__colonne--3 { translate: 0 5%; }

  .rideau__defile {
    display: flex;
    flex-direction: column;
    gap: clamp(0.75rem, 2vw, 1.5rem);
  }

  .rideau__carte {
    aspect-ratio: 3 / 2;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.1);
    flex: none;
  }

  .rideau__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.55;
    filter: saturate(1.05) brightness(0.75);
  }

  /* Défilement en boucle : le contenu est dupliqué, on translate de -50%.
   * Sens et vitesse alternés par colonne. */
  @media (prefers-reduced-motion: no-preference) {
    .rideau__defile {
      animation: rideau-monte var(--duree, 60s) linear infinite;
    }
    .rideau__colonne--1 .rideau__defile { --duree: 70s; }
    .rideau__colonne--2 .rideau__defile { animation-name: rideau-descend; --duree: 85s; }
    .rideau__colonne--3 .rideau__defile { --duree: 60s; }
    .rideau__colonne--4 .rideau__defile { animation-name: rideau-descend; --duree: 75s; }
  }

  @keyframes rideau-monte {
    from { translate: 0 0; }
    to   { translate: 0 -50%; }
  }

  @keyframes rideau-descend {
    from { translate: 0 -50%; }
    to   { translate: 0 0; }
  }

  /* Mobile : 3 colonnes qui couvrent toute la largeur (pas de bande vide
   * entre les photos — le léger débord est rogné par le hero). Le voile
   * radial assure la lisibilité du titre au centre. */
  @media (max-width: 51.99rem) {
    .rideau {
      gap: 0.75rem;
      justify-content: center;
      /* Débord réduit + fondu resserré : les bandes couvrent quasi toute
       * la hauteur de l'écran dès le départ. */
      inset: -6% -8%;
      mask-image: linear-gradient(
        to bottom,
        transparent 0%,
        black 4%,
        black 94%,
        transparent 100%
      );
    }
    .rideau__colonne--3 {
      display: none;
    }
    .rideau__colonne {
      flex-basis: 40vw;
    }
    /* Cartes en portrait : la « bobine » d'une colonne (4 photos + espaces)
     * devient plus haute que l'écran → aucun vide, ni au départ ni pendant
     * la boucle (le défilement seamless exige bobine ≥ fenêtre visible). */
    .rideau__carte {
      aspect-ratio: 2 / 3;
    }
  }

  /* Voile : halo sombre derrière le titre (lisibilité au centre, rideau
   * visible sur les côtés) + fondu vers la section suivante. */
  .hero-accueil::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(
        68% 58% at 50% 42%,
        color-mix(in srgb, var(--bg) 92%, transparent) 0%,
        color-mix(in srgb, var(--bg) 62%, transparent) 55%,
        transparent 80%
      ),
      linear-gradient(to bottom, transparent 62%, var(--bg) 96%);
  }

  /* Halo accent discret derrière le titre. */
  .hero-accueil::after {
    content: '';
    position: absolute;
    z-index: -1;
    top: 38%;
    left: 50%;
    width: min(48rem, 90vw);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    background: radial-gradient(
      circle,
      var(--accent-voile) 0%,
      transparent 62%
    );
    pointer-events: none;
  }

  .hero-accueil__contenu {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--esp-sm);
    max-width: 60rem;
  }

  .hero-accueil__kicker {
    font-family: var(--font-titres), sans-serif;
    font-size: var(--taille-petit);
    font-weight: 600;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--accent-texte);
  }

  .hero-accueil__titre {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 0.98;
    font-size: var(--taille-titre-hero);
    text-shadow: 0 2px 40px color-mix(in srgb, var(--bg) 80%, transparent);
  }

  .hero-accueil__amp {
    font-weight: 400;
    color: var(--accent);
    font-size: 0.7em;
    margin-block: -0.05em;
  }

  .hero-accueil__dates {
    margin-top: var(--esp-xs);
    font-family: var(--font-titres), sans-serif;
    font-size: var(--taille-h3);
    font-weight: 600;
    color: var(--texte);
  }

  .hero-accueil__dates sup {
    font-size: 0.6em;
  }

  .hero-accueil__sous {
    font-size: var(--taille-corps);
    color: var(--texte-doux);
    letter-spacing: 0.01em;
  }

  /* Indicateur de scroll. */
  .hero-accueil__scroll {
    position: absolute;
    bottom: var(--esp-lg);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--esp-2xs);
    font-family: var(--font-titres), sans-serif;
    font-size: var(--taille-petit);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--texte-doux);
    transition: color var(--transition);
  }

  .hero-accueil__scroll:hover {
    color: var(--accent);
  }

  .hero-accueil__chevron {
    width: 0.85rem;
    height: 0.85rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-accueil__chevron {
      animation: hero-rebond 1.8s ease-in-out infinite;
    }
  }

  @keyframes hero-rebond {
    0%,
    100% {
      transform: rotate(45deg) translate(0, 0);
      opacity: 0.7;
    }
    50% {
      transform: rotate(45deg) translate(3px, 3px);
      opacity: 1;
    }
  }

  /* ————————————————————— Périple ————————————————————— */
  .periple {
    position: relative;
    /* `clip` et pas `hidden` : hidden ferait de la section le conteneur de
     * défilement du sticky de la carte (qui ne collerait plus jamais). */
    overflow: clip;
    /* Contexte d'empilement : le voile ::before (z-index -1) reste au-dessus
     * du fond opaque du body. */
    isolation: isolate;
  }

  /* Voyage en images : la cover du jour traversé s'affiche en plein écran
   * derrière le contenu, très atténuée, avec fondu croisé entre jours
   * voisins — même mécanique que les marqueurs (view-timeline du jour).
   * Remplace le voyage chromatique de main. Calques plein viewport en
   * position fixed, invisibles hors de la plage de leur jour. */
  /* Le wrapper ne doit PAS occuper de cellule dans la grille .voyage :
   * display: contents le retire du flux, seuls les calques fixed existent. */
  .fonds {
    display: contents;
  }

  .fonds__calque {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0;
  }

  .fonds__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Atténuation : sombre et légèrement désaturée pour la lisibilité. */
    filter: brightness(0.5) saturate(0.9);
  }

  /* Vignette : renforce la lisibilité au centre (carte + cartes de jours)
   * et fond les bords haut/bas dans la page. */
  .fonds__calque::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        90% 90% at 50% 50%,
        color-mix(in srgb, var(--bg) 55%, transparent) 0%,
        transparent 60%
      ),
      linear-gradient(
        to bottom,
        var(--bg) 0%,
        transparent 22% 78%,
        var(--bg) 100%
      );
  }

  @supports (timeline-scope: --a) and (animation-timeline: view()) {
    .fonds__calque {
      animation: fond-plateau linear both;
      animation-range: cover 0% cover 100%;
    }
    .fonds__calque--1 { animation-timeline: --jour-1; }
    .fonds__calque--2 { animation-timeline: --jour-2; }
    .fonds__calque--3 { animation-timeline: --jour-3; }
    .fonds__calque--4 { animation-timeline: --jour-4; }
    .fonds__calque--5 { animation-timeline: --jour-5; }
    .fonds__calque--6 { animation-timeline: --jour-6; }
    .fonds__calque--7 { animation-timeline: --jour-7; }
    .fonds__calque--8 { animation-timeline: --jour-8; }
  }

  /* Plateau : apparition en fondu (0→25%), tenue (25→75%), effacement. */
  @keyframes fond-plateau {
    0%, 100% { opacity: 0; }
    25%, 75% { opacity: 0.34; }
  }

  /* Mouvement réduit : pas de fonds animés du tout. */
  @media (prefers-reduced-motion: reduce) {
    .fonds {
      display: none;
    }
  }

  .periple__intro {
    text-align: center;
    max-width: var(--largeur-prose);
    margin-bottom: var(--esp-xl);
  }

  .periple__titre {
    font-size: var(--taille-h2);
  }

  .periple__accroche {
    margin-top: var(--esp-sm);
    color: var(--texte-doux);
    text-wrap: balance;
  }

  /* ————————— Voyage : carte sticky + jours ————————— */
  .voyage {
    display: grid;
    /* Carte paysage (Lyon↔Poitiers) : colonne large, élargie au-delà du
     * container standard pour la lisibilité. */
    grid-template-columns: minmax(24rem, 1.35fr) 1fr;
    max-width: min(96rem, 100%);
    gap: clamp(1.5rem, 4vw, 4rem);
    /* PAS d'align-items: start — la colonne de la carte doit s'étirer sur
     * toute la hauteur de la rangée pour donner sa course au sticky. */
    /* Remonte les view-timelines des jours (colonne droite) au niveau du
     * conteneur pour que les marqueurs de la carte (colonne gauche) puissent
     * s'y abonner. */
    timeline-scope:
      --jour-1, --jour-2, --jour-3, --jour-4,
      --jour-5, --jour-6, --jour-7, --jour-8;
  }

  .voyage__carte {
    position: relative;
  }

  /* Dimensionné au ratio exact de l'image OSM (1500×708, paysage) : les
   * positions en % des marqueurs correspondent précisément aux lieux réels. */
  .carte {
    position: sticky;
    /* Carte basse (paysage) : calée vers le tiers haut du viewport. */
    top: 16vh;
    width: 100%;
    aspect-ratio: 1500 / 708;
    margin-inline: auto;
    border-radius: var(--rayon-carte, 20px);
    border: 1px solid rgb(255 255 255 / 0.08);
    background: color-mix(in srgb, var(--bg) 88%, #1b2344);
    overflow: hidden;
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.45);
  }

  /* Fond OSM passé en mode nuit : inversion + rotation de teinte. */
  .carte__osm {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: fill;
    filter: grayscale(0.15) invert(0.92) hue-rotate(185deg) saturate(0.85)
      brightness(0.92) contrast(0.95);
  }

  /* Vignette : fond lisible sous les marqueurs, bords fondus dans la page. */
  .carte::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(110% 110% at 50% 50%, transparent 55%, rgb(5 8 20 / 0.55) 100%),
      linear-gradient(to bottom, rgb(5 8 20 / 0.3), transparent 18%);
  }

  .carte__attribution {
    position: absolute;
    right: 0.6rem;
    bottom: 0.4rem;
    z-index: 2;
    font-size: 0.58rem;
    letter-spacing: 0.04em;
    color: rgb(232 234 242 / 0.55);
  }

  .carte__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* PAS de vector-effect: non-scaling-stroke ici : combiné à pathLength="1",
   * Chrome calcule alors le dash en pixels écran et le dessin au scroll
   * devient des pointillés erratiques. Le panneau ayant le ratio exact du
   * viewBox, l'épaisseur reste uniforme (unités viewBox ≈ ×4 à l'écran). */
  .carte__trace {
    stroke: color-mix(in srgb, var(--accent) 75%, #ffffff);
    stroke-width: 0.55;
    stroke-linecap: round;
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--accent) 55%, transparent));
  }

  /* Retour : ambre, un peu plus fin (le motif pointillé est incompatible
   * avec le dessin par stroke-dashoffset). */
  .carte__trace--retour {
    stroke: color-mix(in srgb, #f59e0b 80%, #ffffff);
    stroke-width: 0.45;
    opacity: 0.9;
    filter: drop-shadow(0 0 6px rgb(245 158 11 / 0.4));
  }

  .carte__ville {
    position: absolute;
    translate: -50% -50%;
    font-family: var(--font-titres), sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--texte-doux);
  }

  .carte__ville--lyon { left: 95.8%; top: 82%; }
  .carte__ville--poitiers { left: 6.7%; top: 33%; }
  .carte__ville--romagne { left: 14.9%; top: 62%; }

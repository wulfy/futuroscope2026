---
/*
 * index.astro — page d'accueil : hero plein écran + section « périple »
 * (tracé d'itinéraire SVG animé au scroll + timeline des 8 jours).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Itineraire from '../components/Itineraire.astro';
import Timeline from '../components/Timeline.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const jours = (await getCollection('jours')).sort(
  (a, b) => a.data.ordre - b.data.ordre,
);
const jour1 = jours[0];
---

<BaseLayout
  title="Souvenirs — Futuroscope & Poitiers"
  description="Huit jours de vacances de Lyon à Poitiers : road trip en Tesla, trois jours au Futuroscope, Aquascope, SPA au Clos de la Ribaudière et Vallée des Singes. Un carnet de voyage immersif."
  ogImage={jour1.data.cover}
>
  <main id="contenu">
    {/* ——— Hero d'accueil ——— */}
    <header class="hero-accueil">
      {/* Constellation des covers : les 8 jours flottent autour du titre,
          chacun à sa profondeur (taille/inclinaison/vitesse de dérive au scroll). */}
      <div class="montage" aria-hidden="true">
        {
          jours.map((jour, i) => (
            <div class={`montage__carte montage__carte--${i + 1}`}>
              <Image
                class="montage__img"
                src={jour.data.cover}
                alt=""
                widths={[360, 540]}
                sizes="(min-width: 52rem) 14rem, 7rem"
                loading="eager"
              />
            </div>
          ))
        }
      </div>

      <div class="hero-accueil__contenu">
        <p class="hero-accueil__kicker">Carnet de voyage</p>
        <h1 class="hero-accueil__titre">
          <span>Futuroscope</span>
          <span class="hero-accueil__amp">&amp;</span>
          <span>Poitiers</span>
        </h1>
        <p class="hero-accueil__dates">25 juillet → 1<sup>er</sup> août 2026</p>
        <p class="hero-accueil__sous">8 jours de Lyon à Poitiers</p>
      </div>

      <a class="hero-accueil__scroll" href="#periple">
        <span>Le périple</span>
        <span class="hero-accueil__chevron" aria-hidden="true"></span>
      </a>
    </header>

    {/* ——— Périple : tracé + timeline ——— */}
    <section id="periple" class="periple section" aria-labelledby="periple-titre">
      <div class="periple__intro container">
        <h2 id="periple-titre" class="periple__titre">Le périple, jour après jour</h2>
        <p class="periple__accroche">
          De la route en Tesla jusqu'au retour au coucher du soleil, suivez le
          fil de nos huit journées le long du tracé Lyon&nbsp;→&nbsp;Poitiers.
        </p>
      </div>

      <div class="periple__piste">
        <Itineraire />
        <Timeline />
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* ————————————————————— Hero ————————————————————— */
  .hero-accueil {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--esp-xl) var(--esp-sm);
    overflow: hidden;
    isolation: isolate;
  }

  /* ——— Constellation des covers ——— */
  .montage {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .montage__carte {
    position: absolute;
    width: var(--taille, clamp(7.5rem, 12vw, 11rem));
    aspect-ratio: 3 / 2;
    border-radius: var(--rayon, 12px);
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.14);
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.45);
    opacity: 0.62;
    /* Propriété de transform indépendante : la rotation reste posée pendant
     * que la dérive au scroll anime `translate` (pas d'écrasement mutuel). */
    rotate: var(--rot, 0deg);
  }

  .montage__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(1.05) brightness(0.9);
  }

  /* Position, inclinaison, profondeur (taille) et vitesse de dérive par carte. */
  .montage__carte--1 { top: 9%;    left: 5%;   --rot: -8deg; --taille: clamp(9rem, 15vw, 14rem);  --derive: -140px; }
  .montage__carte--2 { top: 34%;   left: -2%;  --rot: 5deg;  --derive: -60px; }
  .montage__carte--3 { top: 60%;   left: 7%;   --rot: -4deg; --derive: -100px; }
  .montage__carte--4 { bottom: 3%; left: 24%;  --rot: 7deg;  --taille: clamp(6rem, 10vw, 9rem);   --derive: -40px; }
  .montage__carte--5 { top: 11%;   right: 6%;  --rot: 6deg;  --derive: -120px; }
  .montage__carte--6 { top: 38%;   right: -2%; --rot: -6deg; --taille: clamp(9rem, 15vw, 14rem);  --derive: -70px; }
  .montage__carte--7 { top: 64%;   right: 8%;  --rot: 3deg;  --derive: -90px; }
  .montage__carte--8 { bottom: 5%; right: 25%; --rot: -7deg; --taille: clamp(6rem, 10vw, 9rem);   --derive: -50px; }

  /* Mobile : moins de cartes, plus petites, calées vers les bords. */
  @media (max-width: 51.99rem) {
    .montage__carte {
      --taille: clamp(5rem, 24vw, 7.5rem) !important;
      opacity: 0.5;
    }
    .montage__carte--4,
    .montage__carte--8 {
      display: none;
    }
    .montage__carte--1 { top: 6%;  left: -4%; }
    .montage__carte--3 { top: 72%; left: -3%; }
    .montage__carte--5 { top: 7%;  right: -4%; }
    .montage__carte--7 { top: 70%; right: -3%; }
  }

  /* Dérive parallax : chaque carte remonte à sa vitesse pendant qu'on quitte
   * le hero (100 premiers vh). CSS pur, `translate` seul est animé. */
  @supports (animation-timeline: view()) {
    .montage__carte {
      animation: montage-derive linear both;
      animation-timeline: scroll(root block);
      animation-range: 0 100vh;
    }
  }

  @keyframes montage-derive {
    to {
      translate: 0 var(--derive, -80px);
    }
  }

  /* Flottement ambiant très lent (indépendant du scroll), sur l'image
   * intérieure pour ne pas entrer en conflit avec la dérive. */
  @media (prefers-reduced-motion: no-preference) {
    .montage__img {
      animation: montage-flotte var(--flotte, 9s) ease-in-out infinite alternate;
    }
    .montage__carte--2 .montage__img { --flotte: 11s; }
    .montage__carte--3 .montage__img { --flotte: 8s; }
    .montage__carte--5 .montage__img { --flotte: 10s; }
    .montage__carte--7 .montage__img { --flotte: 12s; }
  }

  @keyframes montage-flotte {
    from {
      translate: 0 -4px;
      scale: 1.06;
    }
    to {
      translate: 0 4px;
      scale: 1.06;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .montage__carte,
    .montage__img {
      animation: none !important;
      translate: none !important;
    }
  }

  /* Voile : halo sombre derrière le titre (lisibilité au centre, cartes
   * visibles sur les bords) + fondu vers la section suivante. */
  .hero-accueil::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(
        62% 52% at 50% 42%,
        color-mix(in srgb, var(--bg) 88%, transparent) 0%,
        color-mix(in srgb, var(--bg) 55%, transparent) 58%,
        transparent 82%
      ),
      linear-gradient(to bottom, transparent 64%, var(--bg) 97%);
  }

  /* Halo accent discret derrière le titre. */
  .hero-accueil::after {
    content: '';
    position: absolute;
    z-index: -1;
    top: 38%;
    left: 50%;
    width: min(48rem, 90vw);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    background: radial-gradient(
      circle,
      var(--accent-voile) 0%,
      transparent 62%
    );
    pointer-events: none;
  }

  .hero-accueil__contenu {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--esp-sm);
    max-width: 60rem;
  }

  .hero-accueil__kicker {
    font-family: var(--font-titres), sans-serif;
    font-size: var(--taille-petit);
    font-weight: 600;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--accent-texte);
  }

  .hero-accueil__titre {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 0.98;
    font-size: var(--taille-titre-hero);
    text-shadow: 0 2px 40px color-mix(in srgb, var(--bg) 80%, transparent);
  }

  .hero-accueil__amp {
    font-weight: 400;
    color: var(--accent);
    font-size: 0.7em;
    margin-block: -0.05em;
  }

  .hero-accueil__dates {
    margin-top: var(--esp-xs);
    font-family: var(--font-titres), sans-serif;
    font-size: var(--taille-h3);
    font-weight: 600;
    color: var(--texte);
  }

  .hero-accueil__dates sup {
    font-size: 0.6em;
  }

  .hero-accueil__sous {
    font-size: var(--taille-corps);
    color: var(--texte-doux);
    letter-spacing: 0.01em;
  }

  /* Indicateur de scroll. */
  .hero-accueil__scroll {
    position: absolute;
    bottom: var(--esp-lg);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--esp-2xs);
    font-family: var(--font-titres), sans-serif;
    font-size: var(--taille-petit);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--texte-doux);
    transition: color var(--transition);
  }

  .hero-accueil__scroll:hover {
    color: var(--accent);
  }

  .hero-accueil__chevron {
    width: 0.85rem;
    height: 0.85rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-accueil__chevron {
      animation: hero-rebond 1.8s ease-in-out infinite;
    }
  }

  @keyframes hero-rebond {
    0%,
    100% {
      transform: rotate(45deg) translate(0, 0);
      opacity: 0.7;
    }
    50% {
      transform: rotate(45deg) translate(3px, 3px);
      opacity: 1;
    }
  }

  /* ————————————————————— Périple ————————————————————— */
  .periple {
    position: relative;
    overflow: hidden;
    /* Contexte d'empilement : le voile ::before (z-index -1) reste au-dessus
     * du fond opaque du body. */
    isolation: isolate;
  }

  /* Voyage chromatique : en descendant la timeline, le fond se teinte
   * successivement de l'accent de chaque jour (rouge route → ambre sunset).
   * Piloté par la progression de la section dans le viewport, 0 Ko de JS. */
  @supports (animation-timeline: view()) {
    .periple::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      background-color: color-mix(in srgb, #e82127 8%, transparent);
      animation: periple-voyage linear both;
      animation-timeline: view();
      animation-range: cover 0% cover 100%;
    }
  }

  @keyframes periple-voyage {
    0%   { background-color: color-mix(in srgb, #e82127 8%, transparent); }
    14%  { background-color: color-mix(in srgb, #fb923c 8%, transparent); }
    28%  { background-color: color-mix(in srgb, #22d3ee 8%, transparent); }
    42%  { background-color: color-mix(in srgb, #8b5cf6 9%, transparent); }
    56%  { background-color: color-mix(in srgb, #ec4899 8%, transparent); }
    70%  { background-color: color-mix(in srgb, #34d399 8%, transparent); }
    84%  { background-color: color-mix(in srgb, #22c55e 8%, transparent); }
    100% { background-color: color-mix(in srgb, #f59e0b 9%, transparent); }
  }

  @media (prefers-reduced-motion: reduce) {
    .periple::before {
      animation: none !important;
    }
  }

  .periple__intro {
    text-align: center;
    max-width: var(--largeur-prose);
    margin-bottom: var(--esp-xl);
  }

  .periple__titre {
    font-size: var(--taille-h2);
  }

  .periple__accroche {
    margin-top: var(--esp-sm);
    color: var(--texte-doux);
    text-wrap: balance;
  }

  /* Piste : contexte de positionnement pour le tracé absolu + la timeline. */
  .periple__piste {
    position: relative;
  }
</style>

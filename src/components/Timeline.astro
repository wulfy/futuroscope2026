---
/*
 * Timeline.astro — la liste des 8 jours accrochée le long du tracé d'itinéraire.
 * getCollection('jours') triée par `ordre`, une TimelineCard par jour.
 * Mobile : 1 colonne, tracé à gauche. Desktop : alternance gauche/droite de part
 * et d'autre du tracé central (la colonne vertébrale = le SVG d'Itineraire).
 * Chaque item porte `.reveal` (apparition au scroll, fournie par effets.css) avec
 * un délai décalé.
 */
import { getCollection } from 'astro:content';
import TimelineCard from './TimelineCard.astro';

const jours = (await getCollection('jours')).sort(
  (a, b) => a.data.ordre - b.data.ordre,
);
---

<ol class="timeline">
  {
    // Accent via classe accent-<ambiance> (les attributs style sont bloqués par la CSP à hashes).
    jours.map((jour) => (
      <li
        class={`timeline__item reveal${jour.data.ambiance ? ` accent-${jour.data.ambiance}` : ''}`}
      >
        <TimelineCard entry={jour} />
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--largeur-max);
    margin-inline: auto;
    /* Dégage la colonne de gauche pour le tracé (mobile). */
    padding-left: 4.25rem;
    padding-right: var(--esp-sm);
    display: flex;
    flex-direction: column;
    gap: var(--esp-lg);
  }

  .timeline__item {
    position: relative;
  }

  /* Ligne courte reliant la carte au tracé. */
  .timeline__item::before {
    content: '';
    position: absolute;
    top: 3.1rem;
    height: 2px;
    right: 100%;
    width: 2.75rem;
    background: linear-gradient(
      to left,
      var(--accent),
      color-mix(in srgb, var(--accent) 10%, transparent)
    );
  }

  /* Nœud posé sur le tracé. */
  .timeline__item::after {
    content: '';
    position: absolute;
    top: 2.75rem;
    right: calc(100% + 2.75rem - 0.45rem);
    width: 0.9rem;
    height: 0.9rem;
    border-radius: var(--rayon-plein);
    background: var(--accent);
    box-shadow:
      0 0 0 4px var(--bg),
      0 0 12px color-mix(in srgb, var(--accent) 65%, transparent);
  }

  /* — Desktop : alternance de part et d'autre du tracé central — */
  @media (min-width: 52rem) {
    .timeline {
      padding-left: var(--esp-sm);
      padding-right: var(--esp-sm);
      gap: var(--esp-xl);
    }

    .timeline__item {
      width: calc(50% - 3.25rem);
    }

    /* Impairs à gauche, connecteur vers la droite (centre). */
    .timeline__item:nth-child(odd) {
      margin-right: auto;
    }
    .timeline__item:nth-child(odd)::before {
      left: 100%;
      right: auto;
      width: 3.25rem;
      background: linear-gradient(
        to right,
        var(--accent),
        color-mix(in srgb, var(--accent) 10%, transparent)
      );
    }
    .timeline__item:nth-child(odd)::after {
      left: calc(100% + 3.25rem - 0.45rem);
      right: auto;
    }

    /* Pairs à droite, connecteur vers la gauche (centre). */
    .timeline__item:nth-child(even) {
      margin-left: auto;
    }
    .timeline__item:nth-child(even)::before {
      right: 100%;
      left: auto;
      width: 3.25rem;
    }
    .timeline__item:nth-child(even)::after {
      right: calc(100% + 3.25rem - 0.45rem);
      left: auto;
    }

    /* Léger décalage vertical pour l'effet zigzag. */
    .timeline__item:nth-child(even) {
      margin-top: calc(-1 * var(--esp-2xl));
    }
    .timeline__item:first-child {
      margin-top: 0;
    }
  }

  /* ——— Entrée latérale : les cartes glissent depuis leur côté du tracé avec
   * une légère rotation (impaires ← gauche, paires → droite). On ne remplace
   * que le nom d'animation : la timeline/range/fill viennent du `.reveal`
   * global (effets.css), et prefers-reduced-motion y coupe tout. ——— */
  @supports (animation-timeline: view()) {
    .timeline__item.reveal {
      animation-name: arrivee-gauche;
    }
    .timeline__item.reveal:nth-child(even) {
      animation-name: arrivee-droite;
    }
  }

  @keyframes arrivee-gauche {
    from {
      opacity: 0;
      transform: translate(-2.75rem, 1.75rem) rotate(-2.5deg);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes arrivee-droite {
    from {
      opacity: 0;
      transform: translate(2.75rem, 1.75rem) rotate(2.5deg);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>

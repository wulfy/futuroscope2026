---
/*
 * Itineraire.astro — LA SIGNATURE DU SITE.
 * Tracé SVG sinueux Lyon → Poitiers → retour qui descend le long de la section
 * timeline et se dessine au scroll (stroke-dashoffset piloté par une view-timeline
 * CSS, zéro JS). Le tracé EST la colonne vertébrale de la timeline : les cartes
 * des jours s'accrochent de part et d'autre.
 *
 * Ce composant se place en couche absolue dans une piste `position: relative`
 * (cf. index.astro). Purement décoratif → aria-hidden.
 *
 * Animation :
 *  - `.itineraire` définit une view-timeline nommée `--piste` sur l'axe block ;
 *    comme cette couche remplit toute la hauteur de la piste, sa progression de
 *    visibilité = celle de la section timeline.
 *  - `.itineraire__trace` (le tracé accent) a `pathLength="1"`, donc
 *    dasharray/dashoffset travaillent en valeurs normalisées 0..1. Le keyframe
 *    passe l'offset de 1 (rien) à 0 (entièrement dessiné), rattaché à `--piste`
 *    sur la plage `cover 2% .. cover 72%` (fini avant le bas de section).
 *  - Fallback `@supports not (animation-timeline: view())` → tracé complet.
 *  - `prefers-reduced-motion: reduce` → tracé complet, sans animation.
 */

// Tracé unique partagé par la piste de fond (faible) et le tracé accent (animé).
// viewBox 100 × 1000, étiré verticalement (preserveAspectRatio="none") ; le
// stroke reste net grâce à vector-effect="non-scaling-stroke".
const D = [
  'M50,0',
  'C50,55 70,78 70,120',
  'C70,168 30,192 30,250',
  'C30,312 70,336 70,388',
  'C70,446 30,470 30,516',
  'C30,578 70,602 70,650',
  'C70,712 30,736 30,784',
  'C30,842 70,866 70,908',
  'C70,952 50,972 50,1000',
].join(' ');
---

<div class="itineraire" aria-hidden="true">
  <svg
    class="itineraire__svg"
    viewBox="0 0 100 1000"
    preserveAspectRatio="none"
    fill="none"
  >
    <path class="itineraire__piste" d={D} vector-effect="non-scaling-stroke" />
    <path
      class="itineraire__trace"
      d={D}
      pathLength="1"
      vector-effect="non-scaling-stroke"
    />
  </svg>

  <span class="itineraire__jalon itineraire__jalon--depart">
    <span class="itineraire__point"></span>
    <span class="itineraire__etiquette">
      <span class="itineraire__emoji">🏠</span>Lyon
    </span>
  </span>

  <span class="itineraire__jalon itineraire__jalon--milieu">
    <span class="itineraire__point"></span>
    <span class="itineraire__etiquette">
      <span class="itineraire__emoji">🎢</span>Futuroscope
    </span>
  </span>

  <span class="itineraire__jalon itineraire__jalon--retour">
    <span class="itineraire__point"></span>
    <span class="itineraire__etiquette">
      <span class="itineraire__emoji">🏁</span>Retour Lyon
    </span>
  </span>
</div>

<style>
  .itineraire {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    /* Timeline de visibilité de la piste, référencée par le tracé animé. */
    view-timeline-name: --piste;
    view-timeline-axis: block;
  }

  .itineraire__svg {
    position: absolute;
    top: 0;
    bottom: 0;
    /* Bande étroite calée sur la colonne de la timeline (gauche en mobile). */
    left: 1.5rem;
    width: 44px;
    height: 100%;
    overflow: visible;
  }

  .itineraire__piste,
  .itineraire__trace {
    stroke-width: 3;
    stroke-linecap: round;
  }

  /* Rail de fond, à peine visible : montre le chemin non encore parcouru. */
  .itineraire__piste {
    stroke: var(--bordure);
    stroke-dasharray: 2 7;
    opacity: 0.7;
  }

  /* Tracé accent qui se dessine au scroll. */
  .itineraire__trace {
    stroke: var(--accent);
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    filter: drop-shadow(0 0 5px color-mix(in srgb, var(--accent) 60%, transparent));
    animation: itineraire-tracer linear both;
    animation-timeline: --piste;
    animation-range: cover 2% cover 72%;
  }

  @keyframes itineraire-tracer {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  /* — Jalons (HTML, hors SVG pour éviter la distorsion du preserveAspectRatio) — */
  .itineraire__jalon {
    position: absolute;
    left: 1.5rem;
    /* centré sur la bande SVG (44px de large) */
    transform: translate(calc(22px - 50%), -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--esp-2xs);
    z-index: 1;
  }

  .itineraire__jalon--depart {
    top: 0;
  }
  .itineraire__jalon--milieu {
    top: 51%;
  }
  .itineraire__jalon--retour {
    top: 100%;
  }

  .itineraire__point {
    width: 1rem;
    height: 1rem;
    border-radius: var(--rayon-plein);
    background: var(--accent);
    box-shadow:
      0 0 0 5px var(--bg),
      0 0 16px color-mix(in srgb, var(--accent) 70%, transparent);
  }

  .itineraire__etiquette {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    padding: 0.25rem 0.7rem;
    font-family: var(--font-titres), sans-serif;
    font-size: var(--taille-petit);
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: var(--texte);
    background: color-mix(in srgb, var(--bg) 62%, transparent);
    backdrop-filter: var(--flou-verre);
    border: 1px solid var(--bordure-douce);
    border-radius: var(--rayon-plein);
  }

  .itineraire__emoji {
    font-size: 1.05em;
  }

  /* — Desktop : la bande vient au centre, colonne vertébrale de la timeline — */
  @media (min-width: 52rem) {
    .itineraire__svg {
      left: 50%;
      width: 120px;
      transform: translateX(-50%);
    }

    .itineraire__piste,
    .itineraire__trace {
      stroke-width: 3.5;
    }

    .itineraire__jalon {
      left: 50%;
      transform: translate(-50%, -50%);
    }

    .itineraire__etiquette {
      font-size: var(--taille-corps);
    }
  }

  /* — Sans scroll-driven animations : tracé entièrement dessiné — */
  @supports not (animation-timeline: view()) {
    .itineraire__trace {
      stroke-dashoffset: 0;
      animation: none;
    }
  }

  /* — Mouvement réduit : tracé statique complet — */
  @media (prefers-reduced-motion: reduce) {
    .itineraire__trace {
      stroke-dashoffset: 0;
      animation: none;
    }
  }
</style>

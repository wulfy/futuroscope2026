---
/*
 * Hero.astro — bandeau plein écran d'une page jour (100svh).
 * Cover en LCP (<Image priority>, pas de lazy), dégradé vers --bg, contenu en
 * cascade : emoji, titre géant, sous-titre, méta (date fr-FR + lieu + hôtel).
 *
 * Classes CONTRACTUELLES avec l'agent effets : `hero`, `hero__media`,
 * `hero__contenu` (il y branche dégradés d'ambiance + scale/dim au scroll).
 * Ici : uniquement le layout (sticky, dimensionnement, cascade d'apparition).
 */
import { Image } from 'astro:assets';

interface Props {
  emoji: string;
  titre: string;
  sousTitre?: string;
  date: Date;
  lieu: string;
  hotel?: string;
  cover: ImageMetadata;
  coverAlt: string;
}

const { emoji, titre, sousTitre, date, lieu, hotel, cover, coverAlt } = Astro.props;

const dateFmt = new Intl.DateTimeFormat('fr-FR', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(date);
---

<section class="hero">
  <a href="/" class="hero__retour" aria-label="Revenir à l'accueil">
    <span class="hero__retour-fleche" aria-hidden="true">←</span>
    <span class="hero__retour-texte">Le périple</span>
  </a>

  <div class="hero__media">
    <Image src={cover} alt={coverAlt} layout="full-width" priority class="hero__img" />
    <div class="hero__voile" aria-hidden="true"></div>
  </div>

  <div class="hero__contenu">
    <span class="hero__emoji" aria-hidden="true">{emoji}</span>
    <h1 class="hero__titre">{titre}</h1>
    {sousTitre && <p class="hero__sous">{sousTitre}</p>}

    <p class="hero__meta">
      <span class="hero__meta-item hero__date">
        <span class="hero__picto" aria-hidden="true">🗓️</span>
        <span>{dateFmt}</span>
      </span>
      <span class="hero__meta-item">
        <span class="hero__picto" aria-hidden="true">📍</span>
        <span>{lieu}</span>
      </span>
      {hotel && (
        <span class="hero__meta-item">
          <span class="hero__picto" aria-hidden="true">🏨</span>
          <span>{hotel}</span>
        </span>
      )}
    </p>
  </div>

  <span class="hero__scroll" aria-hidden="true">
    <span class="hero__scroll-txt">défiler</span>
    <span class="hero__scroll-fleche">↓</span>
  </span>
</section>

<style>
  /*
   * Sticky « à la Apple » : le hero reste collé en haut pendant que le corps
   * (fond --bg, z-index supérieur) remonte par-dessus. Les animations liées au
   * scroll (scale/dim de l'image, dégradé d'ambiance) sont posées par effets.css
   * / ambiances.css sur .hero, .hero__media, .hero__contenu.
   */
  .hero {
    position: sticky;
    top: 0;
    z-index: 0;
    min-height: 100svh;
    display: grid;
    grid-template-areas: 'contenu';
    place-items: end start;
    overflow: hidden;
    isolation: isolate;
  }

  /*
   * Lien de retour à l'accueil : posé par-dessus le hero (z-index positif dans
   * le contexte d'empilement isolé de .hero), donc au-dessus de .hero__media
   * (z-index -1, y compris son scrim ::after d'ambiance) et de .hero__contenu.
   * En position absolute (pas fixed) : discret, défile avec le hero sticky.
   */
  .hero__retour {
    position: absolute;
    top: max(0.9rem, env(safe-area-inset-top));
    left: max(0.9rem, env(safe-area-inset-left));
    z-index: 2;
    display: inline-flex;
    align-items: center;
    /* Repliée : cercle ne montrant que la flèche (44px = cible tactile).
     * Le libellé se déplie au survol/focus (cf. .hero__retour-texte). */
    min-height: 44px;
    min-width: 44px;
    justify-content: flex-start;
    padding: 0 0.85rem;
    background: color-mix(in srgb, var(--bg) 55%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: var(--rayon-plein);
    font-family: var(--font-titres), sans-serif;
    font-size: 0.78rem;
    letter-spacing: 0.03em;
    color: var(--texte-doux);
    text-decoration: none;
    transition: border-color var(--transition), color var(--transition);
  }

  .hero__retour:hover,
  .hero__retour:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    color: var(--accent-texte);
  }

  .hero__retour:hover .hero__retour-fleche,
  .hero__retour:focus-visible .hero__retour-fleche {
    transform: translateX(-2px);
  }

  .hero__retour:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .hero__retour-fleche {
    display: inline-block;
    transition: transform var(--transition);
  }

  /* Le libellé est replié « derrière » la flèche (largeur nulle, décalé à
   * gauche, masqué) et glisse en se dépliant au survol/focus. */
  .hero__retour-texte {
    display: inline-block;
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    opacity: 0;
    transform: translateX(-0.55rem);
    transition:
      max-width 0.35s ease,
      opacity 0.3s ease,
      transform 0.35s ease,
      margin-left 0.35s ease;
  }

  .hero__retour:hover .hero__retour-texte,
  .hero__retour:focus-visible .hero__retour-texte {
    max-width: 7.5rem;
    opacity: 1;
    transform: none;
    margin-left: var(--esp-3xs);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__retour,
    .hero__retour-fleche,
    .hero__retour-texte {
      transition: none;
    }
  }

  .hero__media {
    grid-area: contenu;
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Dégradé de lisibilité (le dégradé coloré d'ambiance vient d'ambiances.css). */
  .hero__voile {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, var(--bg) 2%, color-mix(in srgb, var(--bg) 55%, transparent) 30%, transparent 62%),
      linear-gradient(to bottom, color-mix(in srgb, var(--bg) 55%, transparent), transparent 28%);
  }

  .hero__contenu {
    grid-area: contenu;
    width: 100%;
    max-width: var(--largeur-max);
    margin-inline: auto;
    padding: var(--esp-md) var(--esp-sm) clamp(var(--esp-lg), 8svh, var(--esp-2xl));
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--esp-xs);
  }

  @media (min-width: 48rem) {
    .hero__contenu {
      padding-inline: var(--esp-md);
    }
  }

  /* Cascade d'apparition à l'arrivée de page (indépendante du scroll). */
  .hero__emoji,
  .hero__titre,
  .hero__sous,
  .hero__meta {
    animation: hero-monte 700ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
  }
  .hero__emoji { animation-delay: 60ms; }
  .hero__titre { animation-delay: 140ms; }
  .hero__sous { animation-delay: 240ms; }
  .hero__meta { animation-delay: 340ms; }

  @keyframes hero-monte {
    from { opacity: 0; transform: translateY(1.5rem); }
    to { opacity: 1; transform: translateY(0); }
  }

  .hero__emoji {
    font-size: clamp(2.5rem, 1.5rem + 5vw, 4.5rem);
    line-height: 1;
    filter: drop-shadow(0 8px 24px rgba(0, 0, 0, 0.5));
  }

  .hero__titre {
    font-size: var(--taille-titre-hero);
    line-height: var(--interligne-titre);
    letter-spacing: var(--interlettre-titre);
    text-shadow: 0 4px 32px rgba(0, 0, 0, 0.55);
    max-width: 16ch;
  }

  .hero__sous {
    font-size: var(--taille-h3);
    color: var(--texte-doux);
    font-weight: 500;
    max-width: 40ch;
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.5);
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--esp-2xs) var(--esp-md);
    margin-top: var(--esp-2xs);
    font-family: var(--font-titres), sans-serif;
    font-size: var(--taille-petit);
    color: var(--texte-doux);
  }

  .hero__meta-item {
    display: inline-flex;
    align-items: center;
    gap: var(--esp-3xs);
    background: color-mix(in srgb, var(--bg) 45%, transparent);
    backdrop-filter: var(--flou-verre);
    -webkit-backdrop-filter: var(--flou-verre);
    padding: var(--esp-3xs) var(--esp-2xs);
    border-radius: var(--rayon-plein);
    border: 1px solid var(--bordure-douce);
  }

  .hero__date {
    color: var(--texte);
    text-transform: capitalize;
  }

  .hero__picto {
    font-size: 0.95em;
  }

  .hero__scroll {
    position: absolute;
    bottom: var(--esp-sm);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    font-family: var(--font-titres), sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--texte-tenu);
    z-index: 1;
  }

  .hero__scroll-fleche {
    animation: hero-fleche 1.8s ease-in-out infinite;
  }

  @keyframes hero-fleche {
    0%, 100% { transform: translateY(0); opacity: 0.5; }
    50% { transform: translateY(4px); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__emoji,
    .hero__titre,
    .hero__sous,
    .hero__meta,
    .hero__scroll-fleche {
      animation: none;
    }
  }
</style>
